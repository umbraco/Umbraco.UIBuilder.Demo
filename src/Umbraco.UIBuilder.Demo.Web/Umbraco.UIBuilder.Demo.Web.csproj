<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- Works around an SDK 11 rc.3 static web assets compression failure with Umbraco.Cms.StaticAssets 19.0.0-beta1. Recheck on the next SDK. -->
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms" Version="19.0.0-beta1" />
        <PackageReference Include="Umbraco.UIBuilder" Version="19.0.0-beta.1" />
    </ItemGroup>
  
  <ItemGroup> 
    <ProjectReference Include="..\Umbraco.UIBuilder.Demo\Umbraco.UIBuilder.Demo.csproj" />
  </ItemGroup>

  <!-- Force app-local ICU on Windows and Linux (macOS has no app-local ICU build). Otherwise Windows 10 2019H1+ will do it, but older windows 10 and most if not all winodws servers will run NLS -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="68.2.0.9" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="68.2" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\media\d2efjxka\import.csv" />
  </ItemGroup>

    <PropertyGroup>
        <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    </PropertyGroup>

    <PropertyGroup>
        <UserSecretsId>a82cfb48-b51e-43f1-a3b2-79a65195ce2a</UserSecretsId>
    </PropertyGroup>

</Project>
