<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <!-- Released Umbraco CMS packages come from nuget.org only, so a newer pre-release on MyGet
           can't replace the version the demo asks for. -->
      <package pattern="Umbraco.Cms" />
      <package pattern="Umbraco.Cms.*" />
    </packageSource>
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
